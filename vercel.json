{
  "version": 2,
  "headers": [
    {
      "source": "/(.*\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=60, must-revalidate" }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "headers": {
        "Cache-Control": "public, max-age=0, s-maxage=60, stale-while-revalidate=30, must-revalidate"
      },
      "dest": "/index.html"
    },
    { "src": "/about/?$", "dest": "/about.html" },
    { "src": "/vti-image", "dest": "/api/vti-image" },
    { "src": "/score-discovery/?$", "dest": "/api/score-discovery" },
    { "src": "/product/(?<slug>[^/]+)/?$", "dest": "/api/product-seo?slug=$slug" },
    { "src": "/category/(?<slug>[^/]+)/?$", "dest": "/api/category-seo?slug=$slug" },
    { "src": "/category/?$", "dest": "/index.html" },
    { "src": "/collection(?:/.*)?$", "dest": "/index.html" },
    { "src": "/saved$", "dest": "/index.html" },
    { "src": "/search$", "dest": "/index.html" },
    { "src": "/careers/?$", "dest": "/careers.html" },
    { "src": "/command-center/?$", "dest": "/analytics-dashboard.html" },
    { "handle": "filesystem" }
  ]
}
