{
  "version": 2,
  "functions": {
    "api/home-stable.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=60, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/(?:studio/(?:how-scoring-works|scoring)|links(?:-preview)?/studio/scoring)(?:/.*)?$",
      "status": 307,
      "headers": {
        "Location": "/how-vyrdict-scores.html",
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "src": "^/(?:studio|links(?:-preview)?/(?:studio|work))(?:/.*)?$",
      "status": 307,
      "headers": {
        "Location": "/",
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "src": "^/links-preview(?:/index\\.html)?/?$",
      "status": 307,
      "headers": {
        "Location": "/links/",
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "src": "^/$",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "CDN-Cache-Control": "no-store"
      },
      "dest": "/gift-index.html"
    },
    {
      "src": "^/research/?$",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      },
      "dest": "/api/home-stable"
    },
    {
      "src": "/about/?$",
      "dest": "/about.html"
    },
    {
      "src": "/vti-image",
      "dest": "/api/vti-image"
    },
    {
      "src": "/score-discovery/?$",
      "dest": "/api/score-discovery"
    },
    {
      "src": "/viral-10/?$",
      "dest": "/api/removed-growth"
    },
    {
      "src": "/edit/nightstand-essentials/?$",
      "dest": "/api/removed-growth"
    },
    {
      "src": "/battle/dyson-airwrap-vs-shark-flexstyle/?$",
      "dest": "/api/removed-growth"
    },
    {
      "src": "/product/oura-ring-4/?$",
      "dest": "/api/product-legacy-redirect?to=oura-ring-5"
    },
    {
      "src": "/product/(?<slug>[^/]+)/?$",
      "dest": "/api/product-seo?slug=$slug"
    },
    {
      "src": "/category/(?<slug>[^/]+)/?$",
      "dest": "/api/category-seo?slug=$slug"
    },
    {
      "src": "^/creators/?$",
      "dest": "/creators/index.html"
    },
    {
      "src": "^/creators/(?<slug>[a-z0-9-]+)/?$",
      "dest": "/creators/index.html"
    },
    {
      "src": "^/shop-the-feed/?$",
      "dest": "/shop-the-feed/index.html"
    },
    {
      "src": "^/shop-the-feed/chic-gift-edit/?$",
      "status": 307,
      "headers": {
        "Location": "/edit/chic-gifts/",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/shop-the-feed/chic-gifts/?$",
      "status": 307,
      "headers": {
        "Location": "/edit/chic-gifts/",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/shop-the-feed/november-perfume-edit/?$",
      "status": 307,
      "headers": {
        "Location": "/edit/november-perfume/",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/shop-the-feed/november-perfume/?$",
      "status": 307,
      "headers": {
        "Location": "/edit/november-perfume/",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/shop-the-feed/holiday-collectibles/?$",
      "status": 307,
      "headers": {
        "Location": "/edit/holiday-collectibles/",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/shop-the-feed/advent-calendars/?$",
      "status": 307,
      "headers": {
        "Location": "/edit/advent-calendars/",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/shop-the-feed/indian-bags/?$",
      "status": 307,
      "headers": {
        "Location": "/edit/indian-bags/",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/shop-the-feed/haunted-edit/?$",
      "status": 307,
      "headers": {
        "Location": "/edit/haunted-antiques/",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/shop-the-feed/haunted-antiques/?$",
      "status": 307,
      "headers": {
        "Location": "/edit/haunted-antiques/",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/edit/chic-gifts/?$",
      "dest": "/edit/chic-gifts/index.html"
    },
    {
      "src": "^/edit/november-perfume/?$",
      "dest": "/edit/november-perfume/index.html"
    },
    {
      "src": "^/edit/holiday-collectibles/?$",
      "dest": "/edit/holiday-collectibles/index.html"
    },
    {
      "src": "^/edit/advent-calendars/?$",
      "dest": "/edit/advent-calendars/index.html"
    },
    {
      "src": "^/edit/indian-bags/?$",
      "dest": "/edit/indian-bags/index.html"
    },
    {
      "src": "^/edit/haunted-antiques/?$",
      "dest": "/edit/haunted-antiques/index.html"
    },
    {
      "src": "^/shop-the-feed/(?<slug>[a-z0-9-]+)/?$",
      "dest": "/shop-the-feed/index.html"
    },
    {
      "src": "/category/?$",
      "dest": "/shop.html"
    },
    {
      "src": "/collection/viral-right-now/?$",
      "dest": "/viral-now.html"
    },
    {
      "src": "/collection/celebrity-effect/?$",
      "dest": "/celebrity-effect.html"
    },
    {
      "src": "/collection/seen-on-screen/?$",
      "dest": "/seen-on-screen.html"
    },
    {
      "src": "/collection/viral-around-the-world/?$",
      "dest": "/viral-around-the-world.html"
    },
    {
      "src": "/collection/gifts/?$",
      "status": 308,
      "headers": {
        "Location": "/category/gifts/"
      }
    },
    {
      "src": "/collection(?:/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/saved$",
      "dest": "/saved.html"
    },
    {
      "src": "^/search/?$",
      "dest": "/api/home-stable?view=search"
    },
    {
      "src": "/careers/?$",
      "dest": "/careers.html"
    },
    {
      "src": "/command-center/?$",
      "dest": "/analytics-dashboard.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
