{
  "version": 2,
  "routes": [
    { "src": "/sitemap\.xml$", "dest": "/api/sitemap" },
    { "src": "/product/(?<slug>[^/]+)/?$", "dest": "/api/product-seo?slug=$slug" },
    { "src": "/category(?:/.*)?$", "dest": "/index.html" },
    { "src": "/collection(?:/.*)?$", "dest": "/index.html" },
    { "src": "/saved$", "dest": "/index.html" },
    { "src": "/search$", "dest": "/index.html" },
    { "src": "/careers/?$", "dest": "/careers.html" },
    { "handle": "filesystem" }
  ]
}
